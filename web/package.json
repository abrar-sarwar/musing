{
  "name": "musing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "seed": "node --env-file=.env.local --import tsx scripts/seed.ts",
    "db:reset": "cd .. && supabase db reset && cd web && pnpm seed",
    "typecheck": "tsc --noEmit",
    "test:leak": "node --import tsx scripts/leak.test.ts",
    "test:regression": "node --env-file=.env.local --import tsx scripts/regression.ts",
    "test:router": "node --import tsx scripts/router.test.ts",
    "test:discover": "node --import tsx scripts/discover.test.ts",
    "reels:upload": "node --env-file=.env.hosted.local --import tsx scripts/upload-reels.ts",
    "test:signals": "node --import tsx scripts/signals.test.ts",
    "test:whatif": "node --import tsx scripts/whatif.test.ts",
    "eval:muse": "node --env-file=.env.local --import tsx scripts/muse-eval.ts",
    "eval:converge": "node --env-file=.env.local --import tsx scripts/converge-eval.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "next": "16.4.6",
    "openai": "^7.55.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.33.2"
}
