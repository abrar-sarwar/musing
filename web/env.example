# copy to web/.env.local (gitignored). never commit real values.

# meta model api key. ask abrar for it privately. without it the app still runs
# with muse switched off (plain polls), but nothing muse writes will work.
MODEL_API_KEY=

# local supabase. run `supabase status` from the repo root and copy the values.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:56321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
