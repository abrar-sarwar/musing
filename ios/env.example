# copy to ios/.env (gitignored). on a physical phone, localhost is swapped for this mac's lan ip at build time.
API_URL=http://localhost:3000
SUPABASE_URL=http://localhost:56321
SUPABASE_ANON_KEY=paste the anon key printed by `supabase start`

# only against a deployed server (see "hosted" in the root readme). leave out for local.
# DEMO_PASSCODE=
# ADMIN_TOKEN=
